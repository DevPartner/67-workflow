# 67 Meeting Assistant — environment variables
# Run: python -m 67_agent.agent
# DevUI: python devui/main.py  (agent is auto-discovered)
# Prerequisites: az login

# Microsoft Foundry (Remote provider — default)
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL=gpt-4o

# Optional: switch to Local Foundry (uncomment and change agent.py client)
# PROVIDER=local
# FOUNDRY_LOCAL_MODEL=phi-4-mini
